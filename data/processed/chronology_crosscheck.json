      },
      "finding": "A cremation in Aubrey Hole 32's primary fill is 328-543 years (95%) older than the sarsen circle antler."
    },
    "burial_007": {
      "ward_wilson": {
        "weighted_mean_bp": 4365.5,
        "err": 24.0,
        "T": 4.58,
        "df": 1,
        "T_crit_5pct": 3.841,
        "consistent": false
      },
      "combined_intcal20_95": "3080-3060 cal BC (4.0%); 3030-2905 cal BC (91.5%)",
      "finding": "Reproduces Willis et al. 2016 (4366\u00b125 BP, T'=4.6): the two measurements fail the same-age test at 5%, and the source combined them anyway."
    },
    "phase1_ditch_antlers": {
      "ward_wilson": {
        "weighted_mean_bp": 4375.5,
        "err": 6.9,
        "T": 14.98,
        "df": 8,
        "T_crit_5pct": 15.507,
        "consistent": true
      },
      "finding": "The nine ditch antlers pass the same-age test, but only narrowly (T'=14.98 vs 15.507)."
    },
    "repo_claim_stage2_140_years": {
      "repo_says": "System worked ~140 years (Stage 2, 2620-2480 BC)",
      "source_says": "Darvill et al. 2012 Table 3 gives 2620-2480 as \"suggested dates\"; their modelled Stage 2 runs from 2760-2510 cal BC to 2470-2300 cal BC.",
      "duration_bounds_years": [
        40,
        460
      ],
      "finding": "Arithmetic on the published start and end ranges allows anything from ~40 to ~460 years. \"~140 years\" is a rounded table bracket, not a measured lifetime."
    },
    "repo_claim_altar_stone_crushed_2000bc": {
      "source_says": "Darvill et al. 2012 p. 1033: the great trilithon fell after the Stage 4 bluestone oval (2205-1925 cal BC) but before 17th-century AD plans, so the Altar Stone \"could have been laid in its current position at any point between the Neolithic and the early modern era\".",
      "finding": "No date supports collapse at ~2000 BC. The window is roughly 3,700 years wide."
    },
    "repo_claim_single_campaign": {
      "source_says": "Darvill et al. 2012 offer two equally likely Stage 2 scenarios, one with the sarsen circle added \"years, decades, or centuries\" after the trilithons (p. 1033); their conclusion describes \"a long-term process of alteration\" over 15 centuries (p. 1038).",
      "finding": "The radiocarbon data cannot distinguish a single campaign from one spread over a century or more."
    }
  }
}