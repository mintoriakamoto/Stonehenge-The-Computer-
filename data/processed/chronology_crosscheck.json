  "checks": {
    "sarsen_construction_two_dates": {
      "dates": [
        "UB-3821 (circle stone 1)",
        "OxA-4840 (trilithon 53/54)"
      ],
      "ward_wilson": {
        "weighted_mean_bp": 4016.2,
        "err": 19.0,
        "T": 0.59,
        "df": 1,
        "T_crit_5pct": 3.841,
        "consistent": true
      },
      "combined_intcal20_95": "2575-2470 cal BC (95.4%)",
      "gap_trilithon_minus_circle": {
        "median_years": -18,
        "ci95_years": [
          -197,
          106
        ],
        "p_first_older": 0.383
      },
      "finding": "Only two antler dates date the sarsen structure. They pass the same-age test, yet the 95% range for the gap runs from the circle being 197 years older to the trilithon being 106 years older."
    },
    "rejected_ramp_dates": {
      "four_date_test": {
        "weighted_mean_bp": 3983.3,
        "err": 17.1,
        "T": 17.44,
        "df": 3,
        "T_crit_5pct": 7.815,
        "consistent": false
      },
      "ramp_pair_test": {
        "weighted_mean_bp": 3847.4,
        "err": 38.6,
        "T": 1.5,
        "df": 1,
        "T_crit_5pct": 3.841,
        "consistent": true
      },
      "finding": "The four Phase 3 sarsen dates are not one event; Parker Pearson et al. 2007 reassigned OxA-4839/BM-46 to a later pit."
    },
    "y_hole_30_antlers": {
      "ward_wilson": {
        "weighted_mean_bp": 3352.2,
        "err": 12.3,
        "T": 24.07,
        "df": 2,
        "T_crit_5pct": 5.991,
        "consistent": false
      },
      "finding": "The three Y30 antlers do not share one age, so at least one was old or intrusive when deposited."
    },
    "z29_vs_y30": {
      "gap_z29_minus_y30_ub3822": {
        "median_years": 263,
        "ci95_years": [
          98,
          425
        ],
        "p_first_older": 0.999
      }
    },
    "aubrey_hole_to_sarsen_gap": {
      "dates": [
        "OxA-18036 (cremation in Aubrey Hole 32 primary fill)",
